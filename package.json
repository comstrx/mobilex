{
  "name": "mobile",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "start": "bun tools/compile/index.ts development && expo start",
    "android": "bun tools/compile/index.ts development && expo run:android",
    "ios": "bun tools/compile/index.ts development && expo run:ios",
    "export": "bun tools/export/index.ts",
    "check": "biome ci . && bun tools/core/index.ts",
    "fmt": "biome check --write .",
    "typecheck": "bun tools/compile/index.ts production && tsc --noEmit -p . && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test",
    "compile": "bun tools/compile/index.ts production",
    "flow": "bun tools/device/index.ts flow",
    "perf": "bun tools/device/index.ts perf",
    "bench": "set -e; for file in benches/*.bench.ts; do bun \"$file\"; done",
    "compare": "bun tools/device/index.ts compare"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native/assets-registry": "0.87.1",
    "engine": "git+https://github.com/comstrx/bunx.git#v0.1.1",
    "expo": "58.0.7",
    "expo-build-properties": "58.0.10",
    "expo-constants": "58.0.10",
    "expo-crypto": "58.0.6",
    "expo-image-picker": "58.0.10",
    "expo-localization": "58.0.4",
    "expo-location": "58.0.13",
    "expo-notifications": "58.1.2",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.7",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.29.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1",
    "decode-uri-component": "0.5.0"
  }
}
